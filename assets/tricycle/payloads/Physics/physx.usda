#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "tricycle"
    doc = """Generated from Composed Stage of root layer <TEMP>\\tmpnix4ro8v\\tricycle.usdc


Generated from Composed Stage of root layer <TEMP>\\mjcf_import_tricycle_df1lgh4s\\usdex_tricycle\\tricycle.usdc


Generated from Composed Stage of root layer <TEMP>\\mjcf_import_tricycle_df1lgh4s\\temp_tricycle\\tricycle.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tricycle"
{
    over "Geometry"
    {
        over "chassis"
        {
            over "fork"
            {
                over "front_wheel_body"
                {
                    over "front_wheel" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                    }
                }

                over "steer" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "rear_left_body"
            {
                over "rear_left" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "rear_right_body"
            {
                over "rear_right" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }
        }
    }
}

